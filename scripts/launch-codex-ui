#!/usr/bin/env bash
set -euo pipefail

readonly app_version="0.1.90"
readonly port="5900"
readonly url="http://127.0.0.1:${port}"
readonly requested_thread_id="${1:-}"
if [ -n "$requested_thread_id" ] && [[ ! "$requested_thread_id" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Invalid Codex thread ID" >&2
    exit 2
fi
app_url="$url"
if [ -n "$requested_thread_id" ]; then
    app_url="$url/thread/$requested_thread_id"
fi
readonly app_url
readonly data_root="${XDG_DATA_HOME:-$HOME/.local/share}/hype-codex-ui"
readonly state_root="${XDG_STATE_HOME:-$HOME/.local/state}/hype-codex-ui"
readonly native_browser_profile="$data_root/browser-profile"
readonly flatpak_browser_profile="$HOME/.config/hype-codex-ui/browser-profile"
readonly frontend="$data_root/node_modules/.bin/codexapp"
readonly log_file="$state_root/server.log"
readonly launcher_path="$(realpath "${BASH_SOURCE[0]}")"
readonly plugin_root="$(dirname "$(dirname "$launcher_path")")"

mkdir -p "$state_root"
if command -v flock >/dev/null 2>&1; then
    exec 9>"$state_root/launcher.lock"
    flock -x 9
fi

notify() {
    hype notify "Codex UI" "$1" --app "Codex UI" >/dev/null 2>&1 || true
}

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        notify "Missing required command: $1"
        exit 1
    fi
}

install_desktop_integration() {
    local applications_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    local icons_dir="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/scalable/apps"
    local icon_source="$plugin_root/assets/codexui-icon.svg"
    local desktop_file="$applications_dir/codex-ui.desktop"
    local escaped_launcher="${launcher_path//\\/\\\\}"
    escaped_launcher="${escaped_launcher//\"/\\\"}"

    mkdir -p "$applications_dir" "$icons_dir"
    if [ -f "$icon_source" ]; then
        install -m 0644 "$icon_source" "$icons_dir/codex-ui.svg"
        rm -f "$icons_dir/chrome-127.0.0.1__-Default.svg"
    fi

    printf '%s\n' \
        '[Desktop Entry]' \
        'Type=Application' \
        'Name=Codex UI' \
        'Comment=Local Codex development workspace' \
        "Exec=\"$escaped_launcher\"" \
        'Icon=codex-ui' \
        'Terminal=false' \
        'Categories=Development;IDE;' \
        'StartupNotify=true' \
        'StartupWMClass=codex-ui' \
        'X-GNOME-WMClass=codex-ui' \
        >"$desktop_file"

    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database "$applications_dir" >/dev/null 2>&1 || true
    fi
}

install_frontend() {
    mkdir -p "$data_root" "$state_root"
    notify "Installing the Codex UI frontend for first use…"
    npm install --prefix "$data_root" "codexapp@$app_version" >>"$log_file" 2>&1

    if npm install-scripts --help >/dev/null 2>&1; then
        (
            cd "$data_root"
            npm install-scripts approve node-pty codexapp >>"$log_file" 2>&1 || true
            npm rebuild node-pty codexapp >>"$log_file" 2>&1 || true
        )
    fi
}

lock_frontend_to_localhost() {
    local cli_file="$data_root/node_modules/codexapp/dist-cli/index.js"
    [ -f "$cli_file" ] || return 1
    sed -i \
        -e 's/server\.listen(port, "0\.0\.0\.0")/server.listen(port, "127.0.0.1")/' \
        -e 's|Bind:     http://0\.0\.0\.0:|Bind:     http://127.0.0.1:|' \
        "$cli_file"
    grep -q 'server.listen(port, "127.0.0.1")' "$cli_file"
}

start_frontend() {
    if curl --silent --fail --output /dev/null "$url"; then
        return
    fi

    mkdir -p "$state_root"
    nohup "$frontend" \
        --port "$port" \
        --no-tunnel \
        --no-open \
        --no-login \
        --no-password \
        --sandbox-mode workspace-write \
        --approval-policy on-request \
        >>"$log_file" 2>&1 </dev/null &

    for _ in {1..80}; do
        curl --silent --fail --output /dev/null "$url" && return
        sleep 0.25
    done

    notify "Codex UI failed to start. See $log_file"
    exit 1
}

open_app_window() {
    if command -v flatpak >/dev/null 2>&1 && \
        flatpak info io.github.ungoogled_software.ungoogled_chromium >/dev/null 2>&1; then
        flatpak run io.github.ungoogled_software.ungoogled_chromium --user-data-dir="$flatpak_browser_profile" --no-first-run --app="$app_url" --class=codex-ui >/dev/null 2>&1 &
        wait_for_app_window
        return
    fi

    local browser
    for browser in ungoogled-chromium chromium chromium-browser brave-browser brave google-chrome-stable google-chrome; do
        if command -v "$browser" >/dev/null 2>&1; then
            mkdir -p "$native_browser_profile"
            "$browser" --user-data-dir="$native_browser_profile" --no-first-run --app="$app_url" --class=codex-ui >/dev/null 2>&1 &
            wait_for_app_window
            return
        fi
    done

    install_browser
    flatpak run io.github.ungoogled_software.ungoogled_chromium --user-data-dir="$flatpak_browser_profile" --no-first-run --app="$app_url" --class=codex-ui >/dev/null 2>&1 &
    wait_for_app_window
}

install_browser() {
    if ! command -v flatpak >/dev/null 2>&1; then
        notify "No Chromium-family browser or Flatpak installation was found"
        exit 1
    fi

    mkdir -p "$state_root"
    notify "No supported browser found; installing Ungoogled Chromium from Flathub…"

    if ! flatpak remote-add --user --if-not-exists flathub \
        https://flathub.org/repo/flathub.flatpakrepo >>"$log_file" 2>&1; then
        notify "Could not configure Flathub. See $log_file"
        exit 1
    fi

    if ! flatpak install --user --noninteractive flathub \
        io.github.ungoogled_software.ungoogled_chromium >>"$log_file" 2>&1; then
        notify "Could not install Ungoogled Chromium. See $log_file"
        exit 1
    fi
}

find_codex_window() {
    command -v hyprctl >/dev/null 2>&1 || return 0
    hyprctl clients -j 2>/dev/null | node -e 'let input = ""; process.stdin.on("data", chunk => input += chunk); process.stdin.on("end", () => { try { const client = JSON.parse(input).find(item => item.class === "codex-ui" || item.initialClass === "codex-ui" || item.initialTitle === "127.0.0.1_/"); if (client) process.stdout.write(client.address + "\t" + (client.workspace?.name || "")); } catch {} });'
}

wait_for_app_window() {
    for _ in {1..80}; do
        [ -n "$(find_codex_window)" ] && return 0
        sleep 0.05
    done
    return 0
}

toggle_existing_window() {
    local details address workspace
    details="$(find_codex_window)"
    [ -n "$details" ] || return 1
    IFS=$'\t' read -r address workspace <<<"$details"

    if [ -n "$requested_thread_id" ]; then
        hyprctl dispatch "hl.dsp.window.close({ window = \"address:$address\" })" >/dev/null
        sleep 0.15
        return 1
    fi

    if [ "$workspace" = "special:codex-ui" ]; then
        hyprctl dispatch "hl.dsp.workspace.toggle_special(\"codex-ui\")" >/dev/null
    else
        hyprctl dispatch "hl.dsp.window.move({ workspace = \"special:codex-ui\", window = \"address:$address\" })" >/dev/null
    fi
    return 0
}

require_command node
require_command npm
require_command curl
require_command codex
install_desktop_integration

if toggle_existing_window; then
    exit 0
fi


if [ ! -x "$frontend" ]; then
    install_frontend
fi

if ! lock_frontend_to_localhost; then
    notify "Could not secure the Codex UI localhost binding"
    exit 1
fi

start_frontend
open_app_window
